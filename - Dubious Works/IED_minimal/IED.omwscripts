# Inventory Equipment Display
#
# AnimRefresh is bundled and version-guards itself, so if another mod ships a
# newer copy only that one runs. It is PLAYER-only: perspective changes rebuild
# the player's animation object and drop attached VFX, which NPCs are not
# affected by.
PLAYER: scripts/AnimRefresh/AnimRefresh_v2.lua

PLAYER: scripts/show-all-weapons/player.lua
NPC:    scripts/show-all-weapons/npc.lua
