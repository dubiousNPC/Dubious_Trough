@@ -0,0 +1,38 @@
+"""Is this an animated creature or a static prop?
+
+Two questions the CREA export path needs answered before it writes anything.
+Deliberately small: it only detects, it does not export. The Suite has no
+skinned-creature writer, and a half-working one is worse than an honest refusal
+- see SUITE-FINDINGS.md section 2.
+"""
+
+
+def armature_for(objects):
+    """The armature these meshes are weighted to, if there is exactly one."""
+    found = []
+    for obj in objects:
+        if obj.type == 'ARMATURE':
+            found.append(obj)
+        elif obj.type == 'MESH':
+            for modifier in obj.modifiers:
+                if modifier.type == 'ARMATURE' and modifier.object is not None:
+                    found.append(modifier.object)
+            if obj.parent is not None and obj.parent.type == 'ARMATURE':
+                found.append(obj.parent)
+    unique = []
+    for armature in found:
+        if armature not in unique:
+            unique.append(armature)
+    return unique[0] if len(unique) == 1 else (unique[0] if unique else None)
+
+
+def creature_needs_skeleton(objects):
+    """True when a mesh here carries weight in a group named after a bone.
+
+    Vertex groups alone are not enough - a static prop can have them - so this
+    asks for a group whose name matches a bone of the armature the mesh is bound
+    to, and which actually holds weight.
+    """
+    armature = armature_for(objects)
+    if armature is None or armature.type != 'ARMATURE':
+        return False
+    bones = {bone.name for bone in armature.data.bones}
+    for obj in objects:
+        if obj.type != 'MESH':
+            continue
+        indices = {i for i, group in enumerate(obj.vertex_groups)
+                   if group.name in bones}
+        if not indices:
+            continue
+        for vertex in obj.data.vertices:
+            if any(g.group in indices and g.weight > 1e-6 for g in vertex.groups):
+                return True
+    return False
