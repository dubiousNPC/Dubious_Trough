# WhyWalk Boats -- pilot small craft yourself
#
# A WhyWalk module: load it AFTER "00 Core". Its settings sit on Core's
# WhyWalk page, Core's ridingAnim.lua plays the pilot's pose, and it reads
# Core's SharedRay when present.
GLOBAL: scripts/WhyWalk/Boats/boats_global.lua
PLAYER: scripts/WhyWalk/Boats/boats_player.lua
