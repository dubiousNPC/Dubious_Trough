    },
    "variables": "KLUv/QBYWQAABwAAAGJ1dHRvbgA=",
    "bytecode": "KLUv/QBY/QUAAosoLVBNmwOIyMzMEjMzM9MeYv9nN3ZjaZrapKwXFR08NjTNJ0xcIKiCeLNmUtuUAj+ziW/Q8T6siqVyVggFsRqyShS85M6PMFCNf+FEzhURPI+IvCJltQ8oX5qFhXAF/uaHQM/uXCeGRNFcIznBPD3xgQG4QUIS3flIk2MhdacnWldVxYitdCMDcnDCM7MQrk/X/e3uyx9gny7zFb8Di2V+s68QCgDwTIw5FA8sAuQDC2PKszQQC/ABs7Nsgxk=",
    "text": "begin fy_adjust_fpack\r\n\r\n    Short button\r\n    \r\nif ( OnActivate )\r\nelseif ( button )\r\nelse ; do nothing\r\n\treturn\r\nendif\r\n\r\nif ( button == 0 )\r\n\tMessageBox \"Adjust Fannypack to which side?\" \"Back\" \"Left\" \"Right\"\r\nendif\r\n\r\nset button to GetButtonPressed\r\nif ( button == -1 )\r\n\treturn\r\nelseif ( button == 0 )\r\n\tplayer->AddItem \"fy_fannypack_b\" 1\r\nelseif ( button == 1 )\r\n\tplayer->AddItem \"fy_fannypack_l\" 1\r\nelseif ( button == 2 )\r\n\tplayer->AddItem \"fy_fannypack_r\" 1\r\nendif\r\nplayer->PlaySound \"Item Clothes Up\"\r\n\r\nDisable\r\nSetDelete 1\r\nset button to 0\r\n\r\nEnd fy_adjust_fpack"
  },
